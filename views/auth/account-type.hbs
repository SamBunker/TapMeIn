{{!-- Progressive Auth - Account Type Selection (Step 2) --}}

<style>
:root {
    --primary-blue: #1e40af;
    --primary-dark: #1e3a8a;
    --accent-yellow: #fbbf24;
    --success-green: #10b981;
    --gray-50: #f9fafb;
    --gray-100: #f3f4f6;
    --gray-800: #1f2937;
    --gray-900: #111827;
}

.account-type-page {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-dark) 100%);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    position: relative;
    overflow: hidden;
}

.account-type-page::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
    z-index: 0;
}

.account-type-content {
    position: relative;
    z-index: 2;
    color: white;
    padding: 2rem 0;
}

.account-type-card {
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 3rem;
    color: var(--gray-900);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
    max-width: 900px;
    margin: 0 auto;
}

.type-option {
    background: white;
    border: 3px solid var(--gray-100);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    text-align: center;
    transition: all 0.3s ease;
    cursor: pointer;
    height: 100%;
    position: relative;
    overflow: hidden;
}

.type-option:hover {
    border-color: var(--primary-blue);
    transform: translateY(-6px);
    box-shadow: 0 25px 50px rgba(30, 64, 175, 0.15);
}

.type-option.selected {
    background: var(--primary-blue);
    color: white;
    border-color: var(--primary-blue);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(30, 64, 175, 0.2);
}

.type-icon {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2.5rem;
    transition: all 0.3s ease;
}

.type-option:not(.selected) .type-icon {
    background: var(--gray-100);
    color: var(--primary-blue);
}

.type-option.selected .type-icon {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.popular-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--accent-yellow);
    color: var(--gray-900);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    box-shadow: 0 4px 15px rgba(251, 191, 36, 0.3);
}

.progress-bar {
    background: var(--gray-100);
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 2rem;
}

.progress-fill {
    background: var(--primary-blue);
    height: 100%;
    width: 50%; /* Step 2 of 4 */
    border-radius: 3px;
    transition: width 0.5s ease;
}

.back-btn {
    color: white;
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 2rem;
    display: inline-block;
}

.back-btn:hover {
    color: var(--accent-yellow);
    text-decoration: none;
}

.continue-btn {
    background: var(--primary-blue);
    border: none;
    color: white;
    padding: 15px 40px;
    border-radius: 12px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    font-size: 1.1rem;
}

.continue-btn:hover {
    background: var(--primary-dark);
    color: white;
    text-decoration: none;
    transform: translateY(-2px);
}

.continue-btn:disabled {
    background: var(--gray-100);
    color: var(--gray-800);
    cursor: not-allowed;
    transform: none;
}

@media (max-width: 768px) {
    .account-type-card {
        padding: 2rem 1.5rem;
        margin: 1rem;
    }
    
    .type-option {
        padding: 2rem 1.5rem;
        margin-bottom: 1rem;
    }
    
    .type-icon {
        width: 80px;
        height: 80px;
        font-size: 2rem;
    }
}
</style>

<div class="account-type-page">
    <div class="container account-type-content">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-12">
                <a href="/auth/welcome" class="back-btn">
                    <i class="bi bi-arrow-left me-2"></i>Back
                </a>
                
                <div class="account-type-card">
                    <!-- Progress Bar -->
                    <div class="progress-bar">
                        <div class="progress-fill"></div>
                    </div>
                    
                    <!-- Header -->
                    <div class="text-center mb-5">
                        <img src="/images/Logo2-Resized.png" alt="TAP ME IN! Logo" style="height: 60px;" class="mb-3">
                        <h1 class="fw-bold mb-3">What describes you best?</h1>
                        <p class="lead text-muted mb-0">
                            Choose your account type to get personalized features and pricing
                        </p>
                        <small class="text-muted">Step 2 of 4</small>
                    </div>
                    
                    <!-- Account Type Options -->
                    <div class="row g-4 mb-5">
                        <!-- Individual -->
                        <div class="col-lg-4">
                            <div class="type-option" data-type="individual">
                                <div class="type-icon">
                                    <i class="bi bi-person"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Individual</h4>
                                <p class="mb-4">Perfect for personal networking and career development</p>
                                <div class="small mb-3">
                                    <div class="mb-2">✨ Personal branding tools</div>
                                    <div class="mb-2">📊 Basic analytics</div>
                                    <div class="mb-2">🔄 Profile updates</div>
                                    <div class="mb-2">📱 Mobile optimization</div>
                                </div>
                                <div class="fw-bold fs-5 mt-3">Starting at $19.99</div>
                            </div>
                        </div>
                        
                        <!-- Student -->
                        <div class="col-lg-4">
                            <div class="type-option" data-type="student">
                                <div class="popular-badge">Most Popular</div>
                                <div class="type-icon">
                                    <i class="bi bi-mortarboard"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Student</h4>
                                <p class="mb-4">Special pricing for students and recent graduates</p>
                                <div class="small mb-3">
                                    <div class="mb-2">🎓 Student discounts</div>
                                    <div class="mb-2">💼 Career networking tools</div>
                                    <div class="mb-2">📈 Interview tracking</div>
                                    <div class="mb-2">🏆 Professional templates</div>
                                </div>
                                <div class="fw-bold fs-5 mt-3">Starting at $9.99</div>
                            </div>
                        </div>
                        
                        <!-- Business -->
                        <div class="col-lg-4">
                            <div class="type-option" data-type="business">
                                <div class="type-icon">
                                    <i class="bi bi-building"></i>
                                </div>
                                <h4 class="fw-bold mb-3">Business</h4>
                                <p class="mb-4">Advanced features for teams and organizations</p>
                                <div class="small mb-3">
                                    <div class="mb-2">👥 Team management</div>
                                    <div class="mb-2">📊 Advanced analytics</div>
                                    <div class="mb-2">🎨 Custom branding</div>
                                    <div class="mb-2">🔗 API access</div>
                                </div>
                                <div class="fw-bold fs-5 mt-3">Custom pricing</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Continue Button -->
                    <div class="text-center">
                        <button class="continue-btn" id="continueBtn" disabled>
                            Continue <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                        <p class="small text-muted mt-3 mb-0">
                            You can change your account type later in settings
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let selectedType = null;

// Account type selection
document.querySelectorAll('.type-option').forEach(option => {
    option.addEventListener('click', function() {
        // Remove selected from all options
        document.querySelectorAll('.type-option').forEach(opt => {
            opt.classList.remove('selected');
        });
        
        // Add selected to clicked option
        this.classList.add('selected');
        selectedType = this.getAttribute('data-type');
        
        // Enable continue button
        const continueBtn = document.getElementById('continueBtn');
        continueBtn.disabled = false;
        
        // Add some visual feedback
        this.style.transform = 'scale(0.98) translateY(-4px)';
        setTimeout(() => {
            this.style.transform = '';
        }, 150);
    });
});

// Continue button click
document.getElementById('continueBtn').addEventListener('click', function() {
    if (selectedType) {
        // Store selection in session storage for next step
        sessionStorage.setItem('selectedAccountType', selectedType);
        
        // Redirect to registration with account type
        window.location.href = `/auth/register?accountType=${selectedType}`;
    }
});

// Keyboard navigation
document.addEventListener('keydown', function(e) {
    if (e.key === '1') {
        document.querySelector('[data-type="individual"]').click();
    } else if (e.key === '2') {
        document.querySelector('[data-type="student"]').click();
    } else if (e.key === '3') {
        document.querySelector('[data-type="business"]').click();
    } else if (e.key === 'Enter' && selectedType) {
        document.getElementById('continueBtn').click();
    }
});

// Auto-select most popular option after 3 seconds if no selection made
setTimeout(() => {
    if (!selectedType) {
        document.querySelector('[data-type="student"]').click();
    }
}, 3000);
</script>