{{!-- Admin Dashboard with TAP ME IN! Branding --}}
<div class="container-fluid">
    <div class="row">
        <!-- Main content -->
        <main class="col-12 px-md-4">
            <div class="fade-in">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4">
                    <h1 class="display-4 fw-bold" style="color: #000000;">
                        <i class="bi bi-shield-check me-2" style="color: #666666;"></i>
                        Admin Dashboard
                    </h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-outline-secondary">
                                <i class="bi bi-download me-1"></i>Export Report
                            </button>
                        </div>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCardModal">
                            <i class="bi bi-plus me-1"></i>Create Cards
                        </button>
                    </div>
                </div>
            
                <!-- System Stats -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Total Users</div>
                                        <div class="stat-value">{{stats.totalUsers}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-people"></i> Registered
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-people"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Active Cards</div>
                                        <div class="stat-value">{{stats.activeCards}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-check-circle"></i> Live
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-credit-card"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Support Tickets</div>
                                        <div class="stat-value">{{stats.openTickets}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-clock"></i> Pending
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-life-preserver"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Revenue (MTD)</div>
                                        <div class="stat-value">${{stats.monthlyRevenue}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-graph-up"></i> Monthly
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-currency-dollar"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>
            
            <div class="row">
                <!-- Recent Users -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow mb-4">
                        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                            <h6 class="m-0 font-weight-bold">Recent Users</h6>
                            <a href="/admin/users" class="btn btn-sm btn-primary">View All</a>
                        </div>
                        <div class="card-body">
                            {{#if recentUsers.length}}
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>User</th>
                                                <th>Plan</th>
                                                <th>Status</th>
                                                <th>Joined</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {{#each recentUsers}}
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="activity-icon me-2">
                                                                {{substring firstName 0 1}}
                                                            </div>
                                                            <div>
                                                                <div class="fw-semibold">{{firstName}} {{lastName}}</div>
                                                                <small class="text-muted">{{email}}</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge" style="background: #000000; color: #ffffff; border-radius: 8px; padding: 0.25rem 0.5rem;">
                                                            {{subscription.plan}}
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <span class="badge" style="background: #666666; color: #ffffff; border-radius: 8px; padding: 0.25rem 0.5rem;">
                                                            {{subscription.status}}
                                                        </span>
                                                    </td>
                                                    <td>{{formatDate createdAt}}</td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <button class="btn btn-outline-primary" onclick="viewUser('{{_id}}')">
                                                                <i class="bi bi-eye"></i>
                                                            </button>
                                                            <button class="btn btn-outline-secondary" onclick="editUser('{{_id}}')">
                                                                <i class="bi bi-pencil"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                            {{/each}}
                                        </tbody>
                                    </table>
                                </div>
                            {{else}}
                                <div class="text-center py-4">
                                    <i class="bi bi-people fs-1 text-muted mb-3"></i>
                                    <p class="text-muted">No users yet</p>
                                </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
                
                <!-- System Activity -->
                <div class="col-lg-6 mb-4">
                    <div class="stat-card-simple">
                        <div class="mb-3">
                            <h5 class="fw-bold mb-0">System Activity</h5>
                        </div>
                        <div>
                            {{#if systemActivity.length}}
                                <div class="timeline">
                                    {{#each systemActivity}}
                                        <div class="timeline-item mb-3">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0">
                                                    <div class="activity-icon">
                                                        <i class="bi bi-{{icon}}"></i>
                                                    </div>
                                                </div>
                                                <div class="ms-3">
                                                    <h6 class="mb-1">{{title}}</h6>
                                                    <p class="text-muted small mb-1">{{description}}</p>
                                                    <small class="text-muted">{{formatDateTime timestamp}}</small>
                                                </div>
                                            </div>
                                        </div>
                                    {{/each}}
                                </div>
                            {{else}}
                                <div class="text-center py-4">
                                    <i class="bi bi-clock-history fs-1 text-muted mb-3"></i>
                                    <p class="text-muted">No recent activity</p>
                                </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="row">
                <div class="col-12">
                    <div class="stat-card-simple">
                        <div class="mb-3">
                            <h5 class="fw-bold mb-0">Quick Actions</h5>
                        </div>
                        <div>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <button class="btn btn-outline-secondary w-100" data-bs-toggle="modal" data-bs-target="#createCardModal">
                                        <i class="bi bi-credit-card d-block mb-2"></i>
                                        Create Card Batch
                                    </button>
                                </div>
                                <div class="col-md-3">
                                    <a href="/admin/users" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-person-plus d-block mb-2"></i>
                                        Manage Users
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="/admin/support" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-life-preserver d-block mb-2"></i>
                                        Support Queue
                                    </a>
                                </div>
                                <div class="col-md-3">
                                    <a href="/admin/analytics" class="btn btn-outline-secondary w-100">
                                        <i class="bi bi-bar-chart d-block mb-2"></i>
                                        View Reports
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Create Card Batch Modal -->
<div class="modal fade" id="createCardModal" tabindex="-1" aria-labelledby="createCardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCardModalLabel">
                    <i class="bi bi-credit-card me-2"></i>Create Card Batch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCardForm" action="/admin/create-cards" method="POST">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="batchSize" class="form-label">Number of Cards</label>
                            <input type="number" 
                                   class="form-control" 
                                   id="batchSize" 
                                   name="batchSize" 
                                   min="1" 
                                   max="1000" 
                                   value="10"
                                   required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cardType" class="form-label">Card Type</label>
                            <select class="form-select" id="cardType" name="cardType" required>
                                <option value="nfc">NFC Card</option>
                                <option value="qr">QR Code</option>
                                <option value="hybrid">Hybrid (NFC + QR)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="batchNumber" class="form-label">Batch Number</label>
                        <input type="text" 
                               class="form-control" 
                               id="batchNumber" 
                               name="batchNumber" 
                               placeholder="e.g., BATCH001"
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="notes" class="form-label">Notes (Optional)</label>
                        <textarea class="form-control" 
                                  id="notes" 
                                  name="notes" 
                                  rows="3"
                                  placeholder="Manufacturing notes, client information, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus me-1"></i>Create Cards
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Helper functions for admin actions
    function viewUser(userId) {
        window.location.href = `/admin/users/${userId}`;
    }
    
    function editUser(userId) {
        window.location.href = `/admin/users/${userId}/edit`;
    }
    
    // Form submission handling
    document.getElementById('createCardForm').addEventListener('submit', function(e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.innerHTML = '<i class="bi bi-arrow-clockwise bi-spin me-1"></i>Creating...';
        submitBtn.disabled = true;
        
        // Re-enable after timeout if not redirected
        setTimeout(() => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }, 5000);
    });
    
    // Auto-generate batch number
    document.addEventListener('DOMContentLoaded', function() {
        const now = new Date();
        const batchNumber = `BATCH${now.getFullYear()}${(now.getMonth() + 1).toString().padStart(2, '0')}${now.getDate().toString().padStart(2, '0')}_${now.getHours().toString().padStart(2, '0')}${now.getMinutes().toString().padStart(2, '0')}`;
        document.getElementById('batchNumber').value = batchNumber;
    });
</script>