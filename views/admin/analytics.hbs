{{!-- Admin Analytics with TAP ME IN! Branding --}}
<div class="container-fluid">
    <div class="row">
        <!-- Main content -->
        <main class="col-12 px-md-4">
            <div class="fade-in">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4">
                    <h1 class="display-4 fw-bold" style="color: #000000;">
                        <i class="bi bi-graph-up me-2" style="color: #666666;"></i>
                        System Analytics
                    </h1>
                    <div class="btn-toolbar mb-2 mb-md-0">
                        <div class="btn-group me-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="exportReport()">
                                <i class="bi bi-download me-1"></i>Export Report
                            </button>
                        </div>
                        <div class="btn-group">
                            <select class="form-select" id="timeRange" onchange="changeTimeRange(this.value)">
                                <option value="7">Last 7 days</option>
                                <option value="30" selected>Last 30 days</option>
                                <option value="90">Last 90 days</option>
                                <option value="365">Last year</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Key Metrics -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Total Users</div>
                                        <div class="stat-value">{{stats.totalUsers}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-arrow-up"></i> +12% this month
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-people"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Total Cards</div>
                                        <div class="stat-value">{{stats.totalCards}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-credit-card"></i> {{stats.activeCards}} active
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-credit-card"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Total Taps</div>
                                        <div class="stat-value">{{tapAnalytics.totalTaps}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-hand-index"></i> {{round tapAnalytics.avgTapsPerCard}} avg/card
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-hand-index"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card-simple">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <div class="stat-label">Revenue</div>
                                        <div class="stat-value">${{stats.monthlyRevenue}}</div>
                                        <div class="stat-change positive">
                                            <i class="bi bi-arrow-up"></i> +8% this month
                                        </div>
                                    </div>
                                    <div class="activity-icon">
                                        <i class="bi bi-currency-dollar"></i>
                                    </div>
                                </div>
                        </div>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="row g-4 mb-4">
                    <!-- User Growth Chart -->
                    <div class="col-lg-6">
                        <div class="stat-card-simple">
                            <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                                <h5 class="mb-0" style="color: #000000;">
                                    <i class="bi bi-graph-up me-2"></i>User Growth (30 days)
                                </h5>
                            </div>
                            <div>
                                <div id="userGrowthChart" style="height: 300px; width: 100%;">
                                    <!-- Chart placeholder -->
                                    <div class="d-flex align-items-center justify-content-center h-100" style="background: #f8f9fa; border-radius: 8px;">
                                        <div class="text-center">
                                            <i class="bi bi-graph-up fs-1 mb-3" style="color: #000000;"></i>
                                            <p class="text-muted">User growth chart would be rendered here</p>
                                            <small class="text-muted">Using Chart.js or similar charting library</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card Activation Chart -->
                    <div class="col-lg-6">
                        <div class="stat-card-simple">
                            <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                                <h5 class="mb-0" style="color: #000000;">
                                    <i class="bi bi-credit-card me-2"></i>Card Activations (30 days)
                                </h5>
                            </div>
                            <div>
                                <div id="cardActivationChart" style="height: 300px; width: 100%;">
                                    <!-- Chart placeholder -->
                                    <div class="d-flex align-items-center justify-content-center h-100" style="background: #f8f9fa; border-radius: 8px;">
                                        <div class="text-center">
                                            <i class="bi bi-credit-card fs-1 mb-3" style="color: #000000;"></i>
                                            <p class="text-muted">Card activation chart would be rendered here</p>
                                            <small class="text-muted">Using Chart.js or similar charting library</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detailed Analytics -->
                <div class="row g-4 mb-4">
                    <!-- Top Performing Cards -->
                    <div class="col-lg-6">
                        <div class="stat-card-simple">
                            <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                                <h5 class="mb-0" style="color: #000000;">
                                    <i class="bi bi-trophy me-2"></i>Top Performing Cards
                                </h5>
                            </div>
                            <div>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>Card ID</th>
                                                <th>Owner</th>
                                                <th>Taps</th>
                                                <th>Last 7 days</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">CARD001</div>
                                                    <small class="text-muted">Business Card</small>
                                                </td>
                                                <td>John Doe</td>
                                                <td><span class="badge" style="background: #000000; color: #ffffff;">247</span></td>
                                                <td><span style="color: #000000;">+15</span></td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">CARD042</div>
                                                    <small class="text-muted">Personal</small>
                                                </td>
                                                <td>Jane Smith</td>
                                                <td><span class="badge" style="background: #000000; color: #ffffff;">189</span></td>
                                                <td><span style="color: #000000;">+12</span></td>
                                            </tr>
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold">CARD093</div>
                                                    <small class="text-muted">Event Card</small>
                                                </td>
                                                <td>Mike Johnson</td>
                                                <td><span class="badge" style="background: #666666; color: #ffffff;">156</span></td>
                                                <td><span style="color: #000000;">+8</span></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Geographic Distribution -->
                    <div class="col-lg-6">
                        <div class="stat-card-simple">
                            <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                                <h5 class="mb-0" style="color: #000000;">
                                    <i class="bi bi-geo-alt me-2"></i>Geographic Distribution
                                </h5>
                            </div>
                            <div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>United States</span>
                                        <span class="fw-semibold">45%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" style="width: 45%; background: #000000;"></div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>Canada</span>
                                        <span class="fw-semibold">23%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" style="width: 23%; background: #666666;"></div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>United Kingdom</span>
                                        <span class="fw-semibold">18%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" style="width: 18%; background: #8a8a8a;"></div>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span>Australia</span>
                                        <span class="fw-semibold">14%</span>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar" style="width: 14%; background: #b8b8b8;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- System Health -->
                <div class="row g-4 mb-4">
                    <div class="col-12">
                        <div class="stat-card-simple">
                            <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                                <h5 class="mb-0" style="color: #000000;">
                                    <i class="bi bi-heart-pulse me-2"></i>System Health & Performance
                                </h5>
                            </div>
                            <div>
                                <div class="row g-4">
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold mb-2" style="color: #000000;">99.9%</div>
                                            <div class="small text-uppercase fw-bold" style="color: #666666;">Uptime</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold mb-2" style="color: #000000;">< 100ms</div>
                                            <div class="small text-uppercase fw-bold" style="color: #666666;">Avg Response</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold mb-2" style="color: #000000;">0</div>
                                            <div class="small text-uppercase fw-bold" style="color: #666666;">Errors (24h)</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="text-center">
                                            <div class="display-6 fw-bold mb-2" style="color: #000000;">15GB</div>
                                            <div class="small text-uppercase fw-bold" style="color: #666666;">Data Transfer</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<script>
function exportReport() {
    const timeRange = document.getElementById('timeRange').value;
    window.location.href = `/admin/analytics/export?days=${timeRange}`;
}

function changeTimeRange(days) {
    // In a real implementation, this would reload the page with the new time range
    // and regenerate all charts and statistics
    console.log('Changing time range to:', days + ' days');
    // For now, just show an alert
    alert(`Analytics would be updated to show data for the last ${days} days`);
}

// Placeholder for chart initialization
document.addEventListener('DOMContentLoaded', function() {
    // In a real implementation, you would initialize Chart.js charts here
    console.log('Charts would be initialized here using the data:', {
        userGrowth: {{json userGrowth}},
        cardGrowth: {{json cardGrowth}},
        tapAnalytics: {{json tapAnalytics}}
    });
});
</script>