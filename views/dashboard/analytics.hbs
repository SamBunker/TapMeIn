{{!-- Analytics Page - Placeholder --}}
<div class="container-fluid">
    <div class="row">
        
        <!-- Main content -->
        <main class="col-12 px-md-4">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2" style="color: #000000;">
                    <i class="bi bi-graph-up me-2"></i>Analytics Dashboard
                </h1>
            </div>
            
            <!-- Quick Stats -->
            <div class="row mb-4">
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="stat-card-simple">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="stat-label">Active Cards</div>
                                    <div class="stat-value">{{stats.activeCards}}</div>
                                </div>
                                <div class="activity-icon">
                                    <i class="bi bi-credit-card"></i>
                                </div>
                            </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="stat-card-simple">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="stat-label">Total Taps</div>
                                    <div class="stat-value">{{stats.totalTaps}}</div>
                                </div>
                                <div class="activity-icon">
                                    <i class="bi bi-hand-index"></i>
                                </div>
                            </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="stat-card-simple">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="stat-label">This Month</div>
                                    <div class="stat-value">{{stats.thisMonthTaps}}</div>
                                </div>
                                <div class="activity-icon">
                                    <i class="bi bi-calendar"></i>
                                </div>
                            </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-3">
                    <div class="stat-card-simple">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="stat-label">Profiles</div>
                                    <div class="stat-value">{{stats.totalProfiles}}</div>
                                </div>
                                <div class="activity-icon">
                                    <i class="bi bi-person-circle"></i>
                                </div>
                            </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-12">
                    <div class="stat-card-simple">
                        <div class="d-flex align-items-center mb-3" style="background: #f8f9fa; padding: 1rem; border-radius: 12px; border: 1px solid rgba(0, 0, 0, 0.1);">
                            <h5 class="mb-0" style="color: #000000;">Advanced Analytics</h5>
                        </div>
                        <div class="text-center py-5">
                            <i class="bi bi-bar-chart fs-1 mb-3" style="color: #000000;"></i>
                            <h4 style="color: #000000;">Detailed Analytics Coming Soon!</h4>
                            <p class="text-muted">Get insights into your NFC card performance and user engagement.</p>
                            <p class="small text-muted">
                                This feature will include:
                            </p>
                            <ul class="list-unstyled text-muted">
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Real-time tap tracking</li>
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Geographic heat maps</li>
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Time-based analytics</li>
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Device and browser insights</li>
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Conversion tracking</li>
                                <li><i class="bi bi-check2 me-2" style="color: #000000;"></i>Custom reports and exports</li>
                            </ul>
                            <a href="/dashboard" class="btn btn-outline-secondary mt-3">
                                <i class="bi bi-arrow-left me-2"></i>Back to Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>