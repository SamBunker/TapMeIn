{{!-- TAP ME IN! Dashboard with Modern Design --}}

<!-- Dashboard View -->
<div id="dashboard-view" class="view-content">
            {{#if isDemo}}
                <div class="alert alert-info alert-dismissible fade show" role="alert" style="background: linear-gradient(135deg, #1e40af, #1e3a8a); color: white; border: none; border-radius: 12px; margin-bottom: 2rem;">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-play-circle fs-3 me-3"></i>
                        <div>
                            <h5 class="mb-1">🎯 You're viewing a demo!</h5>
                            <p class="mb-0">This is sample data to show you how TAP ME IN! works. Ready to get started?</p>
                        </div>
                        <a href="/auth/welcome" class="btn btn-light ms-auto">
                            <i class="bi bi-rocket me-1"></i>Start Free Trial
                        </a>
                    </div>
                </div>
            {{/if}}
            
            <div class="mb-4 fade-in">
                {{#if welcome}}
                    <h1 class="display-4 fw-bold mb-2">Welcome to TAP ME IN! 🎉</h1>
                    <p class="text-muted">Your account has been created successfully. Let's get you started!</p>
                {{else}}
                    <h1 class="display-4 fw-bold mb-2">Good {{#if morning}}morning{{else if afternoon}}afternoon{{else}}evening{{/if}}, {{#if user.firstName}}{{user.firstName}}{{else}}{{user.email}}{{/if}}! 👋</h1>
                    <p class="text-muted">Here's your network performance today</p>
                {{/if}}
            </div>

            <!-- Stats Grid -->
            <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="stat-label">Total Taps</div>
                                <div class="stat-value">{{stats.totalTaps}}</div>
                                <div class="stat-change positive">
                                    <i class="bi bi-arrow-up"></i> All time connections
                                </div>
                            </div>
                            <div class="activity-icon tap">
                                <i class="bi bi-hand-index"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="stat-label">Active Cards</div>
                                <div class="stat-value">{{stats.activeCards}}</div>
                                <div class="stat-change positive">
                                    <i class="bi bi-plus"></i> {{#if stats.activeCards}}Ready to tap{{else}}Activate your first{{/if}}
                                </div>
                            </div>
                            <div class="activity-icon" style="background: rgba(16, 185, 129, 0.1); color: var(--success-color);">
                                <i class="bi bi-credit-card"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="stat-label">This Month</div>
                                <div class="stat-value">{{stats.thisMonthTaps}}</div>
                                <div class="stat-change positive">
                                    <i class="bi bi-arrow-up"></i> Recent activity
                                </div>
                            </div>
                            <div class="activity-icon milestone">
                                <i class="bi bi-graph-up-arrow"></i>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-lg-3">
                    <div class="stat-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="stat-label">Profiles</div>
                                <div class="stat-value">{{stats.totalProfiles}}</div>
                                <div class="stat-change positive">
                                    <i class="bi bi-person"></i> Dynamic content
                                </div>
                            </div>
                            <div class="activity-icon interview">
                                <i class="bi bi-person-circle"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Section -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold">Quick Actions</h3>
                </div>
                
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="quick-action-card" onclick="document.getElementById('activateCardModal').classList.add('show'); document.getElementById('activateCardModal').style.display='block';" data-bs-toggle="modal" data-bs-target="#activateCardModal">
                            <div class="quick-action-icon">
                                <i class="bi bi-plus-circle"></i>
                            </div>
                            <div class="quick-action-name text-center">Activate Card</div>
                            <div class="text-muted small text-center">Add a new NFC card</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 col-lg-3">
                        <div class="quick-action-card" onclick="window.location.href='/dashboard/profiles'">
                            <div class="quick-action-icon">
                                <i class="bi bi-person-gear"></i>
                            </div>
                            <div class="quick-action-name text-center">Edit Profile</div>
                            <div class="text-muted small text-center">Update your digital card</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 col-lg-3">
                        <div class="quick-action-card" onclick="window.location.href='/dashboard/analytics'">
                            <div class="quick-action-icon">
                                <i class="bi bi-bar-chart"></i>
                            </div>
                            <div class="quick-action-name text-center">View Analytics</div>
                            <div class="text-muted small text-center">See tap performance</div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 col-lg-3">
                        <div class="quick-action-card" onclick="window.location.href='/dashboard/support'">
                            <div class="quick-action-icon">
                                <i class="bi bi-question-circle"></i>
                            </div>
                            <div class="quick-action-name text-center">Get Support</div>
                            <div class="text-muted small text-center">We're here for you</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Activity Feed & Chart -->
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="chart-container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Weekly Analytics</h5>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary">Day</button>
                                <button class="btn btn-outline-secondary active">Week</button>
                                <button class="btn btn-outline-secondary">Month</button>
                            </div>
                        </div>
                        <div class="chart-bars">
                            {{#if chartData.length}}
                                {{#each chartData}}
                                <div class="chart-bar" style="height: {{percentage}}%;" title="{{label}}: {{value}} taps"></div>
                                {{/each}}
                            {{else}}
                                {{!-- Show empty state when no data --}}
                                <div class="text-center py-4">
                                    <i class="bi bi-bar-chart fs-1 text-muted"></i>
                                    <p class="text-muted mt-2">No tap data yet. Start using your cards to see analytics!</p>
                                </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4">
                    <div class="activity-feed">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Live Activity</h5>
                            {{#if recentActivity.length}}
                                <span class="badge bg-success">LIVE</span>
                            {{/if}}
                        </div>
                        
                        {{#if recentActivity.length}}
                            {{#each recentActivity}}
                            <div class="activity-item">
                                <div class="activity-icon tap">
                                    <i class="bi bi-{{icon}}"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">{{title}}</div>
                                    <div class="small text-muted">{{description}}</div>
                                </div>
                                <div class="small text-muted">{{formatDateTime timestamp}}</div>
                            </div>
                            {{/each}}
                        {{else}}
                            <div class="text-center py-5">
                                <div class="activity-icon milestone mx-auto mb-3" style="width: 60px; height: 60px;">
                                    <i class="bi bi-lightning fs-3"></i>
                                </div>
                                <h6>Ready for Action!</h6>
                                <p class="text-muted small">Your activity will appear here once you start using your cards.</p>
                                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#activateCardModal">
                                    Activate Your First Card
                                </button>
                            </div>
                        {{/if}}
                    </div>
                </div>
            </div>
    </div>

<!-- Interview Helper Bubble -->
    <div class="interview-helper" id="interviewHelper">
        <button type="button" class="btn-close position-absolute top-0 end-0 m-2" aria-label="Close" onclick="dismissHelper()" style="filter: brightness(0) invert(1); opacity: 0.8;"></button>
        <h6>💼 Got an interview?</h6>
        <p class="small mb-2">I noticed you had 3 professional card taps this week. Any callbacks?</p>
        <div class="btn-group">
            <button class="btn btn-sm" onclick="handleInterview('yes')">Yes, callback!</button>
            <button class="btn btn-sm" onclick="handleInterview('scheduled')">Scheduled</button>
            <button class="btn btn-sm" onclick="handleInterview('later')">Ask later</button>
        </div>
    </div>

    <!-- Mobile Navigation -->
    <nav class="mobile-nav">
        <div class="mobile-nav-item active" onclick="switchView('dashboard')">
            <i class="bi bi-house-door fs-5"></i>
            <div class="small">Home</div>
        </div>
        <div class="mobile-nav-item" onclick="switchView('analytics')">
            <i class="bi bi-graph-up fs-5"></i>
            <div class="small">Analytics</div>
        </div>
        <div class="mobile-nav-item" onclick="switchView('cards')">
            <i class="bi bi-credit-card fs-5"></i>
            <div class="small">Cards</div>
        </div>
        <div class="mobile-nav-item" onclick="switchView('profile')">
            <i class="bi bi-person fs-5"></i>
            <div class="small">Profile</div>
        </div>
        <div class="mobile-nav-item" onclick="switchView('settings')">
            <i class="bi bi-gear fs-5"></i>
            <div class="small">Settings</div>
        </div>
    </nav>

<!-- Activate Card Modal -->
<div class="modal fade" id="activateCardModal" tabindex="-1" aria-labelledby="activateCardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="activateCardModalLabel">
                    <i class="bi bi-credit-card me-2"></i>Activate NFC Card
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="activateCardForm" action="/dashboard/activate-card" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="activationCode" class="form-label">Activation Code</label>
                        <input type="text" 
                               class="form-control" 
                               id="activationCode" 
                               name="activationCode" 
                               placeholder="Enter the code from your card package"
                               pattern="[A-Z0-9]{6,12}"
                               required>
                        <div class="form-text">
                            Find this code on your card package or receipt.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="cardNickname" class="form-label">Card Nickname (Optional)</label>
                        <input type="text" 
                               class="form-control" 
                               id="cardNickname" 
                               name="nickname" 
                               placeholder="e.g., Business Card, Personal Card"
                               maxlength="50">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check me-1"></i>Activate Card
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // View Switching
    function switchView(viewName) {
        // Update sidebar active state
        document.querySelectorAll('.sidebar-item').forEach(item => {
            item.classList.remove('active');
        });
        
        // Navigate to the appropriate page
        const routes = {
            'dashboard': '/dashboard',
            'cards': '/dashboard/cards',
            'analytics': '/dashboard/analytics',
            'profile': '/dashboard/profiles',
            'settings': '/dashboard/settings'
        };
        
        if (routes[viewName]) {
            window.location.href = routes[viewName];
        }
        
        // Update mobile nav active state
        document.querySelectorAll('.mobile-nav-item').forEach(item => {
            item.classList.remove('active');
        });
    }

    // Toggle Sidebar (Mobile)
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('show');
    }

    // Toggle Theme
    function toggleTheme() {
        const body = document.body;
        if (body.classList.contains('theme-minimal')) {
            body.classList.remove('theme-minimal');
            body.classList.add('theme-dark');
        } else if (body.classList.contains('theme-dark')) {
            body.classList.remove('theme-dark');
            body.classList.add('theme-gradient');
        } else {
            body.classList.remove('theme-gradient');
            body.classList.add('theme-minimal');
        }
    }

    // Interview Helper Functions
    function dismissHelper() {
        const helper = document.getElementById('interviewHelper');
        if (helper) {
            helper.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            helper.style.opacity = '0';
            helper.style.transform = 'translateY(20px)';
            setTimeout(() => {
                helper.style.display = 'none';
            }, 300);
        }
    }

    function handleInterview(response) {
        if (response === 'yes') {
            alert('Great! Let me help you schedule a follow-up reminder.');
            dismissHelper();
        } else if (response === 'scheduled') {
            alert('Congratulations! I\'ll help you prepare for your interview.');
            dismissHelper();
        } else {
            dismissHelper();
        }
    }

    // Auto-uppercase activation code
    document.getElementById('activationCode').addEventListener('input', function() {
        this.value = this.value.toUpperCase();
    });
    
    // Form submission handling
    document.getElementById('activateCardForm').addEventListener('submit', function(e) {
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        
        submitBtn.innerHTML = '<i class="bi bi-arrow-clockwise bi-spin me-1"></i>Activating...';
        submitBtn.disabled = true;
        
        // Re-enable after timeout if not redirected
        setTimeout(() => {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }, 5000);
    });

    // Real-time stats updates
    // Stats are loaded from server-side data and updated when new taps occur
    // No fake incrementing - all data comes from actual database tracking
</script>