# Production Environment Variables
# Copy this file to .env.production and fill in your actual values

# Application
NODE_ENV=production
HOST_PORT=3001
CONTAINER_PORT=3000
BASE_URL=https://your-domain.com

# Database
MONGO_USERNAME=admin
MONGO_PASSWORD=your-secure-mongodb-password
MONGO_PORT=27018
REDIS_PORT=6380
MONGO_DATABASE=tapmeinnfc

# Authentication - GENERATE STRONG RANDOM SECRETS FOR PRODUCTION!
# Use: openssl rand -base64 64
JWT_SECRET=your-production-jwt-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=your-production-refresh-secret-minimum-32-characters-long
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d
SESSION_SECRET=your-production-session-secret-minimum-32-characters-long

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=TapMeIn NFC

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Payment Processing (Stripe)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Geolocation Service (IPInfo)
IPINFO_API_KEY=your-ipinfo-api-key

# AI Service (OpenAI)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Feature Flags
ENABLE_SMS=true
ENABLE_WEBHOOKS=true
ENABLE_AI_EMAIL=false
ENABLE_CALENDAR_INTEGRATION=false

# Trial Configuration
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=5242880

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn-if-using

# Admin User (for initial setup)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=secure-admin-password-change-immediately
